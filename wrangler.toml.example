# SkyGive — Cloudflare Worker config
# Copy to `wrangler.toml` and fill in your own IDs.

name = "skygive-api"
main = "src/worker.js"
compatibility_date = "2024-12-01"
compatibility_flags = ["nodejs_compat"]

# === Replace with your routes ===
# routes = [
#   { pattern = "skygive.app/*", custom_domain = true },
#   { pattern = "api.skygive.app/*", custom_domain = true },
#   { pattern = "v.skygive.app/*", custom_domain = true },
#   { pattern = "badge.skygive.app/*", custom_domain = true },
# ]

# === D1 Database (create with `wrangler d1 create skygive-db`) ===
[[d1_databases]]
binding = "SKYGIVE_DB"
database_name = "skygive-db"
database_id = "YOUR_D1_DATABASE_ID"

# === KV Namespace (create with `wrangler kv:namespace create SKYGIVE_CACHE`) ===
[[kv_namespaces]]
binding = "SKYGIVE_CACHE"
id = "YOUR_KV_NAMESPACE_ID"

# === R2 Bucket (create with `wrangler r2 bucket create skygive-assets`) ===
[[r2_buckets]]
binding = "SKYGIVE_ASSETS"
bucket_name = "skygive-assets"

# === Workers AI ===
[ai]
binding = "AI"

# === Secrets (set with `wrangler secret put <NAME>`) ===
# BSKY_HANDLE          — service account Bluesky handle (e.g. yourservice.bsky.social)
# BSKY_APP_PASSWORD    — Bluesky app password for the service account
# CF_BROWSER_TOKEN     — Cloudflare API token with Browser Rendering permission
